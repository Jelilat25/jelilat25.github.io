/* ============================================================
   JELILAT PORTFOLIO — style.css
   Light & Dark Theme | Premium & Modern | Fully Responsive
   ============================================================ */

/* ─── 1. CSS VARIABLES ─────────────────────────────────── */
:root {
  /* Light theme */
  --bg:          #FAFAFE;
  --bg-alt:      #F4F3FF;
  --bg-card:     #FFFFFF;
  --bg-glass:    rgba(255,255,255,0.85);
  --border:      #EBE8FC;
  --glow:        #EBE8FC;
  --heading:     #110E1F;
  --body:        #4B5563;
  --muted:       #9CA3AF;
  --primary:     #8B5CF6;
  --primary-h:   #7C3AED;
  --primary-l:   #A78BFA;
  --accent:      #A78BFA;
  --link:        #7C3AED;
  --nav-bg:      rgba(250,250,254,0.92);
  --shadow-sm:   0 2px 12px rgba(139,92,246,0.10);
  --shadow-md:   0 6px 28px rgba(139,92,246,0.16);
  --shadow-lg:   0 12px 48px rgba(139,92,246,0.22);
  --input-bg:    #F4F3FF;
  --input-bdr:   #DDD6FE;
  --footer-bg:   #0A0618;
  --timeline-ln: #DDD6FE;
  --section-alt: #F5F3FF;
}
[data-theme="dark"] {
  --bg:          #07040E;
  --bg-alt:      #0F0A1E;
  --bg-card:     rgba(17,10,34,0.7);
  --bg-glass:    rgba(17,10,34,0.8);
  --border:      rgba(124,58,237,0.22);
  --glow:        rgba(91,33,182,0.35);
  --heading:     #F9F5FF;
  --body:        #94A3B8;
  --muted:       #6B7280;
  --primary:     #8B5CF6;
  --primary-h:   #7C3AED;
  --primary-l:   #A78BFA;
  --accent:      #6D28D9;
  --link:        #A78BFA;
  --nav-bg:      rgba(7,4,14,0.94);
  --shadow-sm:   0 2px 16px rgba(124,58,237,0.20);
  --shadow-md:   0 6px 32px rgba(124,58,237,0.28);
  --shadow-lg:   0 12px 56px rgba(124,58,237,0.36);
  --input-bg:    rgba(17,10,34,0.9);
  --input-bdr:   rgba(124,58,237,0.35);
  --footer-bg:   #03020A;
  --timeline-ln: rgba(124,58,237,0.35);
  --section-alt: rgba(17,10,34,0.5);
}

/* ─── 2. RESET & BASE ───────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; font-size: 16px; }
body {
  font-family: 'Inter', system-ui, sans-serif;
  background-color: var(--bg);
  color: var(--body);
  line-height: 1.7;
  overflow-x: hidden;
  transition: background-color 0.4s ease, color 0.4s ease;
}
a { color: var(--link); text-decoration: none; transition: color 0.25s; }
a:hover { color: var(--primary); }
img { max-width: 100%; display: block; }
ul { list-style: none; }
button { cursor: pointer; font-family: inherit; }
input, textarea { font-family: inherit; }

/* ─── 3. TYPOGRAPHY ─────────────────────────────────────── */
h1, h2, h3, h4, h5 {
  font-family: 'Syne', system-ui, sans-serif;
  color: var(--heading);
  line-height: 1.15;
  font-weight: 700;
}
.section-title {
  font-size: clamp(2rem, 4vw, 2.75rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--heading);
}
.eyebrow {
  font-family: 'Inter', sans-serif;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--primary);
  display: block;
  margin-bottom: 0.5rem;
}
.section-sub {
  font-size: 1rem;
  color: var(--body);
  max-width: 54ch;
  margin: 0 auto;
  opacity: 0.85;
}

/* ─── 4. LAYOUT UTILITIES ───────────────────────────────── */
.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
}
.section {
  padding: 6rem 0;
  position: relative;
}
.section-header {
  text-align: center;
  margin-bottom: 3.5rem;
}
.title-bar {
  width: 3rem;
  height: 3px;
  background: linear-gradient(90deg, var(--primary), var(--primary-l));
  border-radius: 2px;
  margin: 1rem auto 0;
}

/* Alternating section bg */
.about-section, .skills-section, .testimonials-section { background: var(--section-alt); }

/* ─── 5. CANVAS & ORBS ──────────────────────────────────── */
#particle-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}
#orb-container {
  position: fixed;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}
.orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  transform: translate(-50%, -50%);
  animation: orbLife 2.2s ease-out forwards;
}
@keyframes orbLife {
  0%   { opacity: 0; transform: translate(-50%,-50%) scale(0); }
  15%  { opacity: 1; transform: translate(-50%,-50%) scale(1); }
  70%  { opacity: 0.6; }
  100% { opacity: 0; transform: translate(-50%,-50%) scale(3.5); }
}
.orb-child {
  animation: orbChildLife 1.8s ease-out forwards;
}
@keyframes orbChildLife {
  0%   { opacity: 0.8; }
  100% { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(0.3); }
}

/* ─── 6. NAVIGATION ─────────────────────────────────────── */
#navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: transparent;
  transition: background 0.35s, box-shadow 0.35s, backdrop-filter 0.35s;
}
#navbar.scrolled {
  background: var(--nav-bg);
  backdrop-filter: blur(16px) saturate(180%);
  -webkit-backdrop-filter: blur(16px) saturate(180%);
  box-shadow: 0 2px 20px rgba(0,0,0,0.12);
}
.nav-inner {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
  padding: 1rem 1.5rem;
}
.nav-brand {
  font-family: 'Syne', sans-serif;
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--heading);
  letter-spacing: -0.03em;
  flex-shrink: 0;
}
.brand-dot { color: var(--primary); }
.nav-links {
  display: flex;
  gap: 0.25rem;
  margin-left: auto;
  align-items: center;
}
.nav-link {
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--body);
  padding: 0.45rem 0.75rem;
  border-radius: 6px;
  transition: color 0.2s, background 0.2s;
  white-space: nowrap;
}
.nav-link:hover, .nav-link.active {
  color: var(--primary);
  background: var(--glow);
}
.nav-actions {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-shrink: 0;
}

/* Theme toggle */
.theme-btn {
  width: 38px; height: 38px;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--bg-card);
  display: grid; place-items: center;
  font-size: 1rem;
  transition: background 0.25s, border-color 0.25s, transform 0.2s;
}
.theme-btn:hover { transform: rotate(20deg); border-color: var(--primary); }
[data-theme="dark"]  .theme-icon-sun  { display: block; }
[data-theme="dark"]  .theme-icon-moon { display: none; }
[data-theme="light"] .theme-icon-sun  { display: none; }
[data-theme="light"] .theme-icon-moon { display: block; }

/* Hamburger */
.hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 38px; height: 38px;
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 8px;
}
.hamburger span {
  display: block;
  height: 2px;
  background: var(--heading);
  border-radius: 2px;
  transition: transform 0.3s, opacity 0.3s;
}
.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; }
.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* Mobile menu */
.mobile-menu {
  display: none;
  background: var(--nav-bg);
  backdrop-filter: blur(16px);
  border-top: 1px solid var(--border);
  padding: 1.5rem;
  transform: translateY(-8px);
  opacity: 0;
  transition: transform 0.3s, opacity 0.3s;
}
.mobile-menu.open {
  display: block;
  transform: translateY(0);
  opacity: 1;
}
.mobile-menu ul { display: flex; flex-direction: column; gap: 0.25rem; }
.mobile-nav-link {
  display: block;
  padding: 0.75rem 1rem;
  font-weight: 500;
  color: var(--body);
  border-radius: 8px;
  transition: background 0.2s, color 0.2s;
}
.mobile-nav-link:hover { background: var(--glow); color: var(--primary); }
.mobile-menu-btns {
  display: flex;
  gap: 0.75rem;
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border);
}

/* ─── 7. BUTTONS ─────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.7rem 1.5rem;
  border-radius: 10px;
  font-family: 'Inter', sans-serif;
  font-size: 0.92rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease;
  border: 2px solid transparent;
  white-space: nowrap;
  text-decoration: none;
}
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
  box-shadow: 0 4px 16px rgba(139,92,246,0.35);
}
.btn-primary:hover {
  background: var(--primary-h);
  border-color: var(--primary-h);
  color: #fff;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(139,92,246,0.48);
}
.btn-secondary {
  background: transparent;
  color: var(--primary);
  border-color: var(--primary);
}
.btn-secondary:hover {
  background: var(--primary);
  color: #fff;
  transform: translateY(-2px);
}
.btn-outline {
  background: transparent;
  color: var(--heading);
  border-color: var(--border);
}
.btn-outline:hover {
  border-color: var(--primary);
  color: var(--primary);
  transform: translateY(-2px);
}
.btn-ghost {
  background: var(--bg-glass);
  color: var(--body);
  border-color: var(--border);
  backdrop-filter: blur(8px);
}
.btn-ghost:hover {
  border-color: var(--primary);
  color: var(--primary);
  transform: translateY(-2px);
}
.btn-sm { padding: 0.45rem 1rem; font-size: 0.82rem; border-radius: 8px; }
.btn-full { width: 100%; }

/* ─── 8. HERO ────────────────────────────────────────────── */
.hero-section {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 7rem 0 4rem;
  position: relative;
  z-index: 2;
}
.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 4rem;
}
.hero-content { display: flex; flex-direction: column; gap: 1.25rem; }
.hero-eyebrow {
  font-size: 1.1rem;
  color: var(--primary);
  font-weight: 500;
}
.hero-name {
  font-size: clamp(2.2rem, 4.5vw, 3.6rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.035em;
  color: var(--heading);
}
.name-accent { color: var(--primary); }
.hero-role-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: clamp(1.1rem, 2.2vw, 1.35rem);
  color: var(--body);
  font-weight: 400;
  min-height: 2.2em;
}
.role-prefix { color: var(--body); }
.role-wrap { display: flex; align-items: center; }
.role-typed {
  color: var(--primary);
  font-weight: 600;
  font-family: 'Syne', sans-serif;
}
.type-cursor {
  color: var(--primary);
  font-weight: 300;
  animation: blink 0.8s step-end infinite;
  margin-left: 1px;
}
@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }

.hero-tagline { color: var(--body); font-size: 1rem; max-width: 48ch; opacity: 0.85; }
.hero-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 0.5rem;
}
.hero-social {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-top: 0.5rem;
}
.social-icon-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.4rem 0.85rem;
  border-radius: 20px;
  border: 1px solid var(--border);
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--body);
  background: var(--bg-glass);
  backdrop-filter: blur(6px);
  transition: all 0.25s;
}
.social-icon-link:hover {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--glow);
  transform: translateY(-2px);
}
.social-icon-link .s-icon { font-size: 1rem; }

/* Profile visual */
.hero-visual {
  display: flex;
  justify-content: center;
  align-items: center;
}
.profile-rig {
  position: relative;
  width: 380px;
  height: 380px;
  flex-shrink: 0;
}
.rig-ring {
  position: absolute;
  border-radius: 50%;
  border: 2px solid;
  animation: spin-ring linear infinite;
}
.rig-ring-outer {
  inset: -28px;
  border-color: transparent var(--primary) transparent var(--primary-l);
  animation-duration: 12s;
  opacity: 0.55;
}
.rig-ring-inner {
  inset: -14px;
  border-color: var(--primary-l) transparent var(--primary) transparent;
  animation-duration: 8s;
  animation-direction: reverse;
  opacity: 0.35;
}
@keyframes spin-ring { to { transform: rotate(360deg); } }
.rig-photo {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, var(--primary), var(--primary-l));
  box-shadow: 0 0 48px rgba(139,92,246,0.45), 0 0 96px rgba(139,92,246,0.2);
}
.rig-photo img { width: 100%; height: 100%; object-fit: cover; }

/* Floating skill badges */
.skill-badge {
  position: absolute;
  background: var(--bg-card);
  border: 1px solid var(--border);
  backdrop-filter: blur(10px);
  padding: 0.45rem 0.9rem;
  border-radius: 20px;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--heading);
  box-shadow: var(--shadow-sm);
  white-space: nowrap;
  animation: floatBadge 3s ease-in-out infinite;
}
.badge-tl { top: 2%; left: -12%; animation-delay: 0s; }
.badge-tr { top: 2%; right: -12%; animation-delay: 0.75s; }
.badge-bl { bottom: 12%; left: -14%; animation-delay: 1.5s; }
.badge-br { bottom: 12%; right: -14%; animation-delay: 2.25s; }
@keyframes floatBadge {
  0%, 100% { transform: translateY(0px); }
  50%       { transform: translateY(-8px); }
}

/* Scroll cue */
.scroll-cue {
  display: flex;
  justify-content: center;
  margin-top: 3rem;
  animation: bounce 2s infinite;
}
.scroll-dot {
  width: 10px; height: 10px;
  background: var(--primary);
  border-radius: 50%;
  box-shadow: 0 0 12px var(--primary);
}
@keyframes bounce {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(8px); }
}

/* ─── 9. ABOUT ──────────────────────────────────────────── */
.about-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 4rem;
  align-items: center;
}
.about-para {
  font-size: 1.02rem;
  line-height: 1.8;
  color: var(--body);
  margin-bottom: 1rem;
}
.about-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 1.25rem 0 1.75rem;
}
.chip {
  padding: 0.4rem 0.9rem;
  border-radius: 20px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--primary);
  transition: all 0.2s;
}
.chip:hover { background: var(--glow); transform: translateY(-2px); }
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
}
.stat-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1.75rem 1.25rem;
  text-align: center;
  transition: transform 0.3s, box-shadow 0.3s;
  box-shadow: var(--shadow-sm);
}
.stat-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--primary);
}
.stat-value {
  font-family: 'Syne', sans-serif;
  font-size: 2.4rem;
  font-weight: 800;
  color: var(--primary);
  line-height: 1;
  display: block;
}
.stat-label {
  font-size: 0.82rem;
  color: var(--muted);
  margin-top: 0.4rem;
  display: block;
  font-weight: 500;
}

/* ─── 10. PROJECTS ───────────────────────────────────────── */
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  justify-content: center;
  margin-bottom: 2.5rem;
}
.filter-btn {
  padding: 0.5rem 1.2rem;
  border-radius: 20px;
  border: 1.5px solid var(--border);
  background: var(--bg-card);
  color: var(--body);
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s;
}
.filter-btn:hover { border-color: var(--primary); color: var(--primary); }
.filter-btn.active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  box-shadow: 0 4px 14px rgba(139,92,246,0.4);
}
.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.project-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  transition: transform 0.32s, box-shadow 0.32s, border-color 0.25s;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
}
.project-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
  border-color: var(--primary);
}
.project-thumb {
  position: relative;
  overflow: hidden;
  aspect-ratio: 16/10;
}
.project-thumb img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.project-card:hover .project-thumb img { transform: scale(1.06); }
.project-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, rgba(139,92,246,0.7), rgba(91,33,182,0.85));
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  opacity: 0;
  transition: opacity 0.3s;
}
.project-card:hover .project-overlay { opacity: 1; }
.project-body { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; }
.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: 0.75rem;
}
.project-tag {
  padding: 0.2rem 0.65rem;
  border-radius: 12px;
  background: var(--glow);
  border: 1px solid var(--border);
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--primary);
}
.project-title {
  font-family: 'Syne', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 0.6rem;
  line-height: 1.3;
}
.project-desc {
  font-size: 0.88rem;
  color: var(--body);
  line-height: 1.6;
  flex: 1;
}
.project-impact {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin-top: 0.85rem;
  padding-top: 0.85rem;
  border-top: 1px solid var(--border);
  font-size: 0.78rem;
  color: var(--primary);
  font-weight: 500;
}
.impact-icon { flex-shrink: 0; }
.project-footer {
  display: flex;
  gap: 0.6rem;
  padding: 1rem 1.25rem;
  border-top: 1px solid var(--border);
}
.project-footer .btn { flex: 1; font-size: 0.8rem; padding: 0.5rem 0.75rem; }
.project-card.hidden { display: none; }

/* ─── 11. EXPERIENCE TIMELINE ───────────────────────────── */
.timeline {
  position: relative;
  max-width: 900px;
  margin: 0 auto;
}
.timeline::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0; bottom: 0;
  width: 2px;
  background: linear-gradient(to bottom, var(--primary), var(--primary-l), transparent);
  transform: translateX(-50%);
}
.timeline-item {
  display: flex;
  justify-content: flex-end;
  padding-right: calc(50% + 2.5rem);
  margin-bottom: 3rem;
  position: relative;
}
.timeline-item:nth-child(even) {
  justify-content: flex-start;
  padding-right: 0;
  padding-left: calc(50% + 2.5rem);
}
.timeline-dot {
  position: absolute;
  left: 50%;
  top: 1.5rem;
  transform: translate(-50%, -50%);
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--bg-card);
  border: 2px solid var(--primary);
  display: grid; place-items: center;
  font-size: 1.1rem;
  z-index: 1;
  box-shadow: 0 0 0 4px var(--glow), var(--shadow-sm);
  transition: transform 0.3s, box-shadow 0.3s;
}
.timeline-item:hover .timeline-dot {
  transform: translate(-50%, -50%) scale(1.15);
  box-shadow: 0 0 0 6px var(--glow), var(--shadow-md);
}
.timeline-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1.5rem;
  max-width: 420px;
  width: 100%;
  box-shadow: var(--shadow-sm);
  transition: transform 0.32s, box-shadow 0.32s, border-color 0.25s;
}
.timeline-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--primary);
}
.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.75rem;
  margin-bottom: 0.5rem;
  flex-wrap: wrap;
}
.timeline-role {
  font-family: 'Syne', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  color: var(--heading);
}
.timeline-company { font-size: 0.9rem; color: var(--primary); font-weight: 600; margin-bottom: 0.35rem; }
.timeline-meta { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; }
.timeline-duration {
  font-size: 0.78rem;
  background: var(--glow);
  border: 1px solid var(--border);
  padding: 0.2rem 0.7rem;
  border-radius: 12px;
  color: var(--primary);
  font-weight: 600;
}
.timeline-type {
  font-size: 0.72rem;
  padding: 0.2rem 0.65rem;
  border-radius: 12px;
  font-weight: 600;
  border: 1px solid var(--border);
  color: var(--muted);
}
.timeline-highlights {
  margin-top: 0.85rem;
  padding-left: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.timeline-highlights li {
  font-size: 0.85rem;
  color: var(--body);
  line-height: 1.55;
  position: relative;
}
.timeline-highlights li::before {
  content: '';
  position: absolute;
  left: -1rem; top: 0.58em;
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--primary);
}

/* ─── 12. SKILLS ─────────────────────────────────────────── */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}
.skill-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 1.75rem;
  box-shadow: var(--shadow-sm);
  transition: transform 0.3s, box-shadow 0.3s, border-color 0.25s;
}
.skill-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--primary);
}
.skill-card-header {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  margin-bottom: 1.5rem;
}
.skill-card-icon {
  width: 48px; height: 48px;
  border-radius: 12px;
  display: grid; place-items: center;
  font-size: 1.4rem;
  background: var(--glow);
  border: 1px solid var(--border);
  flex-shrink: 0;
}
.skill-card-title {
  font-family: 'Syne', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--heading);
}
.skill-items { display: flex; flex-direction: column; gap: 1rem; }
.skill-row { display: flex; flex-direction: column; gap: 0.35rem; }
.skill-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.skill-name { font-size: 0.88rem; font-weight: 500; color: var(--body); }
.skill-pct  { font-size: 0.78rem; font-weight: 600; color: var(--primary); }
.skill-bar-track {
  height: 5px;
  background: var(--border);
  border-radius: 3px;
  overflow: hidden;
}
.skill-bar-fill {
  height: 100%;
  border-radius: 3px;
  background: linear-gradient(90deg, var(--primary), var(--primary-l));
  width: 0%;
  transition: width 1.1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.skill-bar-fill.animated { width: var(--target-width); }

/* ─── 13. SERVICES ───────────────────────────────────────── */
.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.service-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 2rem 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  box-shadow: var(--shadow-sm);
  transition: transform 0.32s, box-shadow 0.32s, border-color 0.25s;
  position: relative;
  overflow: hidden;
}
.service-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--primary), var(--primary-l));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.35s ease;
}
.service-card:hover::before { transform: scaleX(1); }
.service-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
  border-color: var(--primary);
}
.service-icon {
  font-size: 2rem;
  width: 58px; height: 58px;
  border-radius: 14px;
  background: var(--glow);
  border: 1px solid var(--border);
  display: grid; place-items: center;
}
.service-title {
  font-family: 'Syne', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--heading);
}
.service-desc { font-size: 0.88rem; color: var(--body); line-height: 1.65; flex: 1; }
.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.5rem;
}
.service-tag {
  font-size: 0.72rem;
  font-weight: 600;
  padding: 0.2rem 0.65rem;
  border-radius: 10px;
  background: var(--glow);
  border: 1px solid var(--border);
  color: var(--primary);
}
.service-cta {
  margin-top: 0.5rem;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--primary);
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  transition: gap 0.2s;
}
.service-cta:hover { gap: 0.55rem; color: var(--primary); }

/* ─── 14. TESTIMONIALS ───────────────────────────────────── */
.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.75rem;
}
.testi-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.32s, box-shadow 0.32s, border-color 0.25s;
  display: flex;
  flex-direction: column;
}
.testi-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
  border-color: var(--primary);
}
.testi-image-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 12px 12px 0 0;
  background: var(--bg-alt);
}
.testi-image-wrap img {
  width: 100%;
  aspect-ratio: 16/9;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.testi-card:hover .testi-image-wrap img { transform: scale(1.03); }
.testi-img-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(7,4,14,0.5) 0%, transparent 60%);
}
.testi-body { padding: 1.25rem 1.5rem 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; flex: 1; }
.testi-stars {
  display: flex;
  gap: 0.15rem;
  color: #F59E0B;
  font-size: 0.85rem;
}
.testi-person { display: flex; align-items: center; gap: 0.85rem; }
.testi-avatar {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-l));
  display: grid; place-items: center;
  font-size: 1.1rem;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
  font-family: 'Syne', sans-serif;
}
.testi-name { font-weight: 700; font-size: 0.92rem; color: var(--heading); }
.testi-role { font-size: 0.78rem; color: var(--muted); }
.testi-view-btn {
  margin-top: auto;
  padding-top: 0.75rem;
  border-top: 1px solid var(--border);
}

/* ─── 15. CONTACT ───────────────────────────────────────── */
.contact-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 3.5rem;
  align-items: start;
}
.contact-form-wrap {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 2.25rem;
  box-shadow: var(--shadow-sm);
}
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.form-group { display: flex; flex-direction: column; gap: 0.45rem; margin-bottom: 1rem; }
.form-group label { font-size: 0.85rem; font-weight: 600; color: var(--heading); }
.form-group input,
.form-group textarea {
  padding: 0.75rem 1rem;
  border-radius: 10px;
  border: 1.5px solid var(--input-bdr);
  background: var(--input-bg);
  color: var(--heading);
  font-size: 0.9rem;
  transition: border-color 0.25s, box-shadow 0.25s;
  outline: none;
  resize: vertical;
}
.form-group input:focus,
.form-group textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(139,92,246,0.18);
}
.form-status {
  margin-top: 0.75rem;
  font-size: 0.88rem;
  font-weight: 500;
  min-height: 1.2em;
}
.form-status.success { color: #10B981; }
.form-status.error   { color: #EF4444; }
.form-note { font-size: 0.78rem; color: var(--muted); margin-top: 1rem; line-height: 1.5; }
.form-note a { color: var(--primary); }
.contact-info { display: flex; flex-direction: column; gap: 1rem; }
.info-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 1.1rem 1.25rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  box-shadow: var(--shadow-sm);
  transition: transform 0.25s, border-color 0.25s;
}
.info-card:hover { transform: translateX(4px); border-color: var(--primary); }
.info-icon { font-size: 1.4rem; flex-shrink: 0; width: 44px; height: 44px; display: grid; place-items: center; background: var(--glow); border-radius: 10px; }
.info-label { font-size: 0.75rem; color: var(--muted); font-weight: 500; }
.info-value { font-size: 0.9rem; color: var(--heading); font-weight: 600; }
.contact-social { display: flex; flex-wrap: wrap; gap: 0.6rem; }

/* ─── 16. FOOTER ─────────────────────────────────────────── */
#footer {
  background: var(--footer-bg);
  color: var(--footer-text, #94A3B8);
  position: relative;
  z-index: 2;
}
.footer-body { max-width: 1200px; margin: 0 auto; padding: 3.5rem 1.5rem 2rem; }
.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
  gap: 3rem;
  margin-bottom: 3rem;
}
.footer-logo {
  font-family: 'Syne', sans-serif;
  font-size: 2rem;
  font-weight: 800;
  color: #F9F5FF;
  letter-spacing: -0.04em;
  margin-bottom: 0.75rem;
}
.footer-tagline { font-size: 0.88rem; line-height: 1.65; color: #64748B; max-width: 26ch; }
.footer-col-title { font-size: 0.85rem; font-weight: 700; color: #F9F5FF; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 1rem; }
.footer-links { display: flex; flex-direction: column; gap: 0.55rem; }
.footer-links a { font-size: 0.88rem; color: #64748B; transition: color 0.2s; }
.footer-links a:hover { color: var(--primary-l); }
.footer-social {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-top: 1.25rem;
}
.footer-social-link {
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 1px solid rgba(124,58,237,0.3);
  display: grid; place-items: center;
  font-size: 1rem;
  color: #64748B;
  transition: all 0.25s;
  background: rgba(255,255,255,0.04);
}
.footer-social-link:hover {
  border-color: var(--primary);
  color: var(--primary-l);
  background: rgba(139,92,246,0.12);
  transform: translateY(-2px);
}
.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255,255,255,0.06);
  font-size: 0.82rem;
  color: #4B5563;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.back-to-top { color: var(--primary-l); font-weight: 600; transition: color 0.2s; }
.back-to-top:hover { color: var(--primary); }

/* ─── 17. VOICE BOT ──────────────────────────────────────── */
.voicebot {
  background: rgba(10, 4, 22, 0.96);
  border-bottom: 1px solid rgba(124,58,237,0.25);
  backdrop-filter: blur(16px);
}
.vb-toggle {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  background: transparent;
  border: none;
  cursor: pointer;
  color: #F9F5FF;
  font-size: 0.92rem;
  font-weight: 600;
  font-family: 'Inter', sans-serif;
  transition: color 0.2s;
}
.vb-toggle:hover { color: var(--primary-l); }
.vb-avatar {
  width: 40px; height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-l));
  display: grid; place-items: center;
  font-size: 1.2rem;
  flex-shrink: 0;
  box-shadow: 0 0 16px rgba(139,92,246,0.6);
  animation: vbPulse 2.5s ease-in-out infinite;
}
@keyframes vbPulse {
  0%,100% { box-shadow: 0 0 12px rgba(139,92,246,0.5); }
  50%      { box-shadow: 0 0 28px rgba(139,92,246,0.9); }
}
.vb-label { flex: 1; text-align: left; }
.vb-arrow { font-size: 0.7rem; opacity: 0.5; transition: transform 0.3s; }
.vb-toggle[aria-expanded="true"] .vb-arrow { transform: rotate(180deg); }
.vb-panel {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem 1.5rem;
}
.vb-panel:not([hidden]) { display: block; }
.vb-chat {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(124,58,237,0.2);
  border-radius: 12px;
  padding: 1rem;
  min-height: 100px;
  max-height: 220px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
  scroll-behavior: smooth;
}
.vb-chat::-webkit-scrollbar { width: 4px; }
.vb-chat::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.4); border-radius: 2px; }
.bot-bubble, .user-bubble {
  padding: 0.65rem 1rem;
  border-radius: 12px;
  font-size: 0.86rem;
  line-height: 1.55;
  max-width: 85%;
}
.bot-bubble {
  background: rgba(139,92,246,0.18);
  border: 1px solid rgba(139,92,246,0.25);
  color: #D4C8FF;
  align-self: flex-start;
  border-bottom-left-radius: 4px;
}
.user-bubble {
  background: var(--primary);
  color: #fff;
  align-self: flex-end;
  border-bottom-right-radius: 4px;
}
.vb-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}
.vb-chip {
  padding: 0.35rem 0.85rem;
  border-radius: 14px;
  border: 1px solid rgba(124,58,237,0.35);
  background: rgba(124,58,237,0.1);
  color: #A78BFA;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  font-family: 'Inter', sans-serif;
  transition: all 0.2s;
}
.vb-chip:hover { background: rgba(139,92,246,0.25); border-color: var(--primary); color: #fff; }
.vb-input-row {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}
.vb-input-row input {
  flex: 1;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(124,58,237,0.3);
  color: #F9F5FF;
  border-radius: 10px;
  padding: 0.65rem 1rem;
  font-size: 0.88rem;
  font-family: 'Inter', sans-serif;
  outline: none;
  transition: border-color 0.2s;
}
.vb-input-row input:focus { border-color: var(--primary); }
.vb-input-row input::placeholder { color: #4B5563; }
.vb-mic-btn, .vb-send-btn {
  width: 40px; height: 40px;
  border-radius: 10px;
  border: 1px solid rgba(124,58,237,0.35);
  background: rgba(124,58,237,0.12);
  color: #A78BFA;
  font-size: 1rem;
  display: grid; place-items: center;
  transition: all 0.2s;
  flex-shrink: 0;
}
.vb-mic-btn:hover, .vb-send-btn:hover {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}
.vb-mic-btn.listening {
  background: #EF4444;
  border-color: #EF4444;
  color: #fff;
  animation: micPulse 0.9s ease infinite;
}
@keyframes micPulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.5); }
  50%      { box-shadow: 0 0 0 8px rgba(239,68,68,0); }
}

/* ─── 18. SCROLL REVEAL ANIMATIONS ──────────────────────── */
.reveal, .reveal-left, .reveal-right {
  opacity: 0;
  transition: opacity 0.7s ease, transform 0.7s ease;
}
.reveal       { transform: translateY(32px); }
.reveal-left  { transform: translateX(-40px); }
.reveal-right { transform: translateX(40px); }
.reveal.visible,
.reveal-left.visible,
.reveal-right.visible {
  opacity: 1;
  transform: translate(0);
}

/* Stagger children with reveal-child class */
.reveal-stagger .reveal-child {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.5s ease, transform 0.5s ease;
}
.reveal-stagger.visible .reveal-child { opacity: 1; transform: translateY(0); }
.reveal-stagger.visible .reveal-child:nth-child(1) { transition-delay: 0.05s; }
.reveal-stagger.visible .reveal-child:nth-child(2) { transition-delay: 0.15s; }
.reveal-stagger.visible .reveal-child:nth-child(3) { transition-delay: 0.25s; }
.reveal-stagger.visible .reveal-child:nth-child(4) { transition-delay: 0.35s; }
.reveal-stagger.visible .reveal-child:nth-child(5) { transition-delay: 0.45s; }
.reveal-stagger.visible .reveal-child:nth-child(6) { transition-delay: 0.55s; }

/* ─── 19. RESPONSIVE — Tablet (≤900px) ──────────────────── */
@media (max-width: 900px) {
  .hero-grid          { grid-template-columns: 1fr; gap: 3rem; text-align: center; }
  .hero-content       { align-items: center; }
  .hero-btns          { justify-content: center; }
  .hero-social        { justify-content: center; }
  .profile-rig        { width: 280px; height: 280px; }
  .badge-tl           { top: -4%; left: -6%; font-size: 0.7rem; padding: 0.35rem 0.7rem; }
  .badge-tr           { top: -4%; right: -6%; }
  .badge-bl           { bottom: 8%; left: -8%; }
  .badge-br           { bottom: 8%; right: -8%; }

  .about-grid         { grid-template-columns: 1fr; gap: 2.5rem; }
  .stats-grid         { grid-template-columns: repeat(4, 1fr); }

  .projects-grid      { grid-template-columns: repeat(2, 1fr); }

  .timeline::before   { left: 1.5rem; }
  .timeline-item,
  .timeline-item:nth-child(even) {
    justify-content: flex-start;
    padding-right: 0;
    padding-left: 4.5rem;
  }
  .timeline-dot       { left: 1.5rem; }

  .skills-grid        { grid-template-columns: 1fr; }
  .services-grid      { grid-template-columns: repeat(2, 1fr); }
  .testimonials-grid  { grid-template-columns: 1fr; }
  .contact-grid       { grid-template-columns: 1fr; gap: 2rem; }
  .footer-grid        { grid-template-columns: 1fr 1fr; gap: 2rem; }

  .nav-links          { display: none; }
  .hamburger          { display: flex; }
  #nav-resume-btn     { display: none; }
}

/* ─── 20. RESPONSIVE — Mobile (≤600px) ──────────────────── */
@media (max-width: 600px) {
  .section { padding: 4rem 0; }
  .hero-section { padding: 6rem 0 3rem; }
  .hero-name { font-size: clamp(1.8rem, 8vw, 2.4rem); }
  .hero-btns { flex-direction: column; align-items: stretch; }
  .hero-btns .btn { text-align: center; }
  .profile-rig { width: 220px; height: 220px; }
  .badge-tl, .badge-tr, .badge-bl, .badge-br { display: none; }

  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .projects-grid { grid-template-columns: 1fr; }
  .services-grid { grid-template-columns: 1fr; }
  .form-row { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
  .footer-bottom { flex-direction: column; text-align: center; }
  .filter-row { gap: 0.4rem; }
  .filter-btn { font-size: 0.78rem; padding: 0.4rem 0.9rem; }
  .hero-role-row { font-size: 1rem; }
  .section-title { font-size: clamp(1.6rem, 6vw, 2.2rem); }
}

/* ─── 21. REDUCED MOTION ─────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
  #particle-canvas { display: none; }
}

/* ─── 22. SCROLLBAR ──────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 3px; opacity: 0.6; }
::-webkit-scrollbar-thumb:hover { opacity: 1; }

/* ─── 23. SELECTION ──────────────────────────────────────── */
::selection { background: rgba(139,92,246,0.3); color: var(--heading); }